<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 앱 제목 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- 공유 URL 초기화 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="공유 URL 관리"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="공유 URL을 초기화하면 새로운 디바이스 ID, 디바이스 키, 개인 키가 생성됩니다."
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/buttonResetSharedUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_shared_url"
            android:background="@drawable/button_rounded_red"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- 배터리 절약 설정 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/batteryModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/spinner_rounded"
            android:layout_marginBottom="16dp" />

        <!-- 현재 설정 표시 -->
        <TextView
            android:id="@+id/currentSettingsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/current_settings"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <!-- 위치 추적 제어 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tracking_control"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/trackingControlSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/spinner_rounded"
            android:layout_marginBottom="16dp" />

        <!-- 위치 공유 상태 설정 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/location_sharing_settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/shareStatusSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/spinner_rounded"
            android:layout_marginBottom="16dp" />

        <!-- 저장 버튼 -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_button"
            android:background="@drawable/button_rounded_blue"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 메인 화면으로 돌아가기 -->
        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="메인 화면으로"
            android:background="@drawable/button_rounded_green"
            android:textColor="@android:color/white"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView> 