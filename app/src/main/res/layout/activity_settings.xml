<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 앱 제목 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- 디바이스 설정 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="디바이스 설정"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/device_id_hint"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/device_key_hint"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editText3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/private_key_hint"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:focusable="false"
            android:clickable="false"
            android:layout_marginBottom="16dp" />

        <!-- 배터리 절약 설정 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/batteryModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/normal_mode"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/radioPower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/power_saving_mode"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/radioUltra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ultra_saving_mode"
                android:padding="8dp" />
        </RadioGroup>

        <!-- 현재 설정 표시 -->
        <TextView
            android:id="@+id/currentSettingsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/current_settings"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <!-- 위치 추적 제어 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tracking_control"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/trackingControlGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/radioTrackingNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/resume_tracking" />
            <RadioButton
                android:id="@+id/radioPause5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pause_5min" />
            <RadioButton
                android:id="@+id/radioPause10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pause_10min" />
            <RadioButton
                android:id="@+id/radioPause30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pause_30min" />
            <RadioButton
                android:id="@+id/radioStop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stop_tracking" />
        </RadioGroup>

        <!-- 키 초기화 버튼 -->
        <Button
            android:id="@+id/buttonResetKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="키 초기화"
            android:background="@android:color/holo_orange_dark"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <!-- 저장 버튼 -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_button"
            android:background="@android:color/holo_blue_dark"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 메인 화면으로 돌아가기 -->
        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="메인 화면으로"
            android:background="@android:color/holo_green_dark"
            android:textColor="@android:color/white"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView> 